{
  "name": "brand-growth-os-cf",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native brand, spatial & packaging 3D rendering, campaign strategy, and outbound lead outreach OS on Cloudflare",
  "scripts": {
    "dev:worker": "wrangler dev",
    "dev:web": "vite web --port 5173",
    "build:web": "vite build web",
    "db:migrate:local": "wrangler d1 migrations apply brand-growth-os-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply brand-growth-os-db --remote",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "npm run build:web && wrangler pages deploy web/dist --project-name=brand-growth-os-ui",
    "test:webhook": "node scripts/test-webhook.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/three": "^0.172.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "three": "^0.172.0"
  }
}
